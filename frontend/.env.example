# Frontend environment — copy to .env.local for local dev.
# In production these are set as Vercel Project Environment Variables.

# Public — exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Server-only — used by Next.js middleware / route handlers, never shipped to client.
# Must match the backend's SECRET_KEY / SESSION_HINT_SECRET so session hints verify.
SECRET_KEY=replace-with-backend-secret-key
SESSION_HINT_SECRET=replace-with-backend-session-hint-secret
AUTH_SECRET=replace-with-openssl-rand-hex-32
