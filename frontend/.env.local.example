# Base URL for all browser API calls, including Google sign-in
# (`${NEXT_PUBLIC_API_URL}/v1/auth/google/start`). In production set this to the
# relative `/api` proxy path (with BACKEND_ORIGIN pointing at the backend) so the
# OAuth state + refresh cookies stay same-origin; the backend GOOGLE_REDIRECT_URI
# must then point at `<frontend>/api/v1/auth/google/callback`.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_stripe_publishable_key
# Verifies the session_hint cookie set by the backend. MUST equal the backend's
# SECRET_KEY or every authenticated route bounces to /login.
SESSION_HINT_SECRET=replace-with-backend-secret-key

# Controls the landing page waitlist/auth button mode. Defaults to true (production waitlist mode).
# Set to false to show the dev / login / register buttons.
NEXT_PUBLIC_WAITLIST_MODE=false
