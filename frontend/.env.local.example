# Base URL for all browser API calls, including Google sign-in
# (`${NEXT_PUBLIC_API_URL}/v1/auth/google/start`). In production set this to the
# relative `/api` proxy path (with BACKEND_ORIGIN pointing at the backend) so the
# OAuth state + refresh cookies stay same-origin; the backend GOOGLE_REDIRECT_URI
# must then point at `<frontend>/api/v1/auth/google/callback`.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Where the /api/* rewrite in next.config.ts forwards to. Read at BUILD time,
# so changing it in a hosting console needs a rebuild, not a restart. Locally
# the default already points at the dev backend; set it per deployed
# environment (staging: https://api.staging.auracles.space).
# BACKEND_ORIGIN=http://localhost:8000
# WebSockets are deliberately NOT proxied through the rewrite — CloudFront and
# most CDNs will not carry the upgrade — so this must address the backend
# directly rather than going through the frontend origin. Derived from
# BACKEND_ORIGIN at build time when unset.
# NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_stripe_publishable_key
# Mirrors the backend's PLATFORM_CURRENCY, for labelling price inputs only.
# The server is the authority and rejects any other currency, so a mismatch
# here shows the wrong symbol but cannot mis-price anything. Keep them equal.
NEXT_PUBLIC_PLATFORM_CURRENCY=NGN
# Paystack's public key is set below but nothing reads it yet: checkout is a
# server-initialized redirect to a hosted page, so the browser never talks to
# Paystack directly. It becomes load-bearing only if the Inline (in-page popup)
# flow is adopted. Harmless to carry until then — publishable keys are public
# by design — but do not expect changing it to alter any behaviour today.
# Verifies the session_hint cookie set by the backend. MUST equal the backend's
# SECRET_KEY or every authenticated route bounces to /login.
SESSION_HINT_SECRET=replace-with-backend-secret-key

# Controls the landing page waitlist/auth button mode. Defaults to true (production waitlist mode).
# Set to false to show the dev / login / register buttons.
NEXT_PUBLIC_WAITLIST_MODE=false

# Waitlist signup collector (app/api/waitlist). Needed ONLY while
# NEXT_PUBLIC_WAITLIST_MODE is true — the route returns 404 otherwise, so the
# main app needs neither.
#
# BOTH are required together, not just the audience id: the route authenticates
# to Resend with the API key as a bearer token and posts the contact to the
# audience (route.ts:87-103). Missing either one returns 502 with nothing but a
# console.error, so a signup form that silently stops working is the symptom.
# RESEND_API_KEY is the same key the backend sends transactional mail with.
# RESEND_API_KEY=re_replace_in_local_env
# RESEND_AUDIENCE_ID=replace-with-resend-audience-uuid

# Paystack configuration. Create a Paystack account and get the public key from the dashboard.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_36006c0fffd52974ffab066e48fafde593dd3b54
NEXT_PUBLIC_PLATFORM_CURRENCY=NGN

# Note on hosted environments: AWS Amplify exposes environment variables to a
# Next.js SSR build, not to the running server. Every server-side value above
# (BACKEND_ORIGIN, SESSION_HINT_SECRET, the Resend pair) must also appear in
# the forwarding grep in amplify.yml or it simply will not exist at runtime.
# NEXT_PUBLIC_* values are inlined by `next build` and need no forwarding.
