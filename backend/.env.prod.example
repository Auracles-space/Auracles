# Template for `.env.prod` — deliberate local-against-production runs.
#
# Copy to `.env.prod` (gitignored) and fill with real remote values, then:
#   ENV_FILE=.env.prod uv run uvicorn app.main:app
#   ENV_FILE=.env.prod uv run celery -A app.workers.celery_app worker
#
# The test suite NEVER uses this file — conftest pins localhost values and a
# guard aborts pytest if a non-local datastore is resolved. Do not commit the
# filled `.env.prod`.

ENVIRONMENT=production
LOG_FORMAT=json
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
# Signs JWTs AND the session_hint cookie. MUST be identical to the frontend's
# SESSION_HINT_SECRET (Vercel) — they sign/verify the same cookie. If they drift,
# every authenticated route redirects to /login in production.
SECRET_KEY=set-from-openssl-rand-hex-32
TOTP_ENCRYPTION_KEY=set-from-fernet-generate-key
PAYOUT_ACCOUNT_ENCRYPTION_KEY=set-from-fernet-generate-key
PARTNER_WEBHOOK_ENCRYPTION_KEY=set-from-fernet-generate-key
CORS_ALLOWED_ORIGINS=https://auracles.space
COOKIE_SAMESITE=strict
ADMIN_EMAIL=admin@auracles.space
ADMIN_PASSWORD=set-strong-password
AWS_ACCESS_KEY_ID=set-from-aws
AWS_SECRET_ACCESS_KEY=set-from-aws
AWS_DEFAULT_REGION=us-east-1
S3_ARTIFACTS_BUCKET=auracles-artifacts
S3_AVATARS_BUCKET=auracles-avatars
S3_REPORTS_BUCKET=auracles-reports
S3_THUMBNAILS_BUCKET=auracles-thumbnails
RESEND_API_KEY=set-from-resend
RESEND_FROM_ADDRESS=noreply@auracles.space
# true (default) = send via Resend. Leave true/unset in production.
EMAIL_SEND_ENABLED=true
STRIPE_SECRET_KEY=set-from-stripe
STRIPE_WEBHOOK_SECRET=set-from-stripe
BRAVE_SEARCH_API_KEY=set-from-brave
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
OCR_TESSERACT_COMMAND=tesseract
OCR_TIMEOUT_SECONDS=60
OCR_PDF_DPI=200
OCR_TESSERACT_PAGE_SEGMENTATION_MODE=6
PLATFORM_COMMISSION_RATE=0.15
