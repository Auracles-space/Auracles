ENVIRONMENT=local
LOG_FORMAT=text
DATABASE_URL=postgresql+asyncpg://auracles:secret@localhost:5432/auracles
REDIS_URL=redis://localhost:6379/0
# Signs JWTs AND the session_hint cookie. MUST equal the frontend's
# SESSION_HINT_SECRET or every authenticated route bounces to /login.
SECRET_KEY=replace-with-openssl-rand-hex-32
TOTP_ENCRYPTION_KEY=replace-with-fernet-generate-key-output
PAYOUT_ACCOUNT_ENCRYPTION_KEY=replace-with-fernet-generate-key-output
PARTNER_WEBHOOK_ENCRYPTION_KEY=replace-with-fernet-generate-key-output
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SAMESITE=strict
ADMIN_EMAIL=admin@auracles.space
ADMIN_PASSWORD=replace-with-strong-local-password
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
S3_ARTIFACTS_BUCKET=auracles-artifacts-dev
S3_AVATARS_BUCKET=auracles-avatars-dev
S3_REPORTS_BUCKET=auracles-reports-dev
S3_THUMBNAILS_BUCKET=auracles-thumbnails-dev
RESEND_API_KEY=replace-in-local-env
RESEND_FROM_ADDRESS=noreply@auracles.space
# false = log lifecycle emails instead of sending (no Resend quota burn). Use locally.
EMAIL_SEND_ENABLED=false
STRIPE_SECRET_KEY=replace-in-local-env
STRIPE_WEBHOOK_SECRET=replace-in-local-env
# Persona identity verification (KYC). Create an inquiry template in the Persona
# dashboard and point a webhook at /v1/webhooks/persona using the same secret.
PERSONA_API_KEY=replace-in-local-env
PERSONA_WEBHOOK_SECRET=replace-in-local-env
PERSONA_INQUIRY_TEMPLATE_ID=replace-in-local-env
# Frontend page Persona returns the user to after the hosted flow completes.
PERSONA_REDIRECT_URL=http://localhost:3000/settings/kyc
BRAVE_SEARCH_API_KEY=replace-in-local-env
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
OCR_TESSERACT_COMMAND=tesseract
OCR_TIMEOUT_SECONDS=60
OCR_PDF_DPI=200
OCR_TESSERACT_PAGE_SEGMENTATION_MODE=6
PLATFORM_COMMISSION_RATE=0.15
# Virus scanning. The worker runs on the host locally, so point it at the
# clamav container over TCP (start it with `docker compose up -d clamav`).
# Leave CLAMAV_HOST unset to fall back to a local Unix-socket clamd instead.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
