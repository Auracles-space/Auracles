ENVIRONMENT=local
LOG_FORMAT=text
DATABASE_URL=postgresql+asyncpg://auracles:secret@localhost:5432/auracles
REDIS_URL=redis://localhost:6379/0
# Signs JWTs AND the session_hint cookie. MUST equal the frontend's
# SESSION_HINT_SECRET or every authenticated route bounces to /login.
SECRET_KEY=replace-with-openssl-rand-hex-32
TOTP_ENCRYPTION_KEY=replace-with-fernet-generate-key-output
PAYOUT_ACCOUNT_ENCRYPTION_KEY=replace-with-fernet-generate-key-output
PARTNER_WEBHOOK_ENCRYPTION_KEY=replace-with-fernet-generate-key-output
CONNECTOR_TOKEN_ENCRYPTION_KEY=replace-with-fernet-generate-key-output
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SAMESITE=strict
ADMIN_EMAIL=dev@auracles.space
ADMIN_PASSWORD=replace-with-strong-local-password
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# eu-west-2 (London) in deployed environments — everything co-located, closest
# practical region to the Nigerian pilot, see infra/README.md. Locally this
# only labels LocalStack, so the value is cosmetic, but keeping it aligned
# avoids a surprise when someone copies it.
AWS_DEFAULT_REGION=eu-west-2
AWS_ENDPOINT_URL=http://localhost:4566
S3_ARTIFACTS_BUCKET=auracles-artifacts-dev
S3_AVATARS_BUCKET=auracles-avatars-dev
S3_REPORTS_BUCKET=auracles-reports-dev
S3_THUMBNAILS_BUCKET=auracles-thumbnails-dev
RESEND_API_KEY=replace-in-local-env
RESEND_FROM_ADDRESS=noreply@auracles.space
# false = log lifecycle emails instead of sending (no Resend quota burn). Use locally.
EMAIL_SEND_ENABLED=false
# Optional: host email *images* load from when the frontend origin is not
# serving yet (staging points this at the live apex). Action links always use
# the frontend origin regardless — they carry tokens minted for the app.
# EMAIL_ASSET_BASE_URL=
STRIPE_SECRET_KEY=replace-in-local-env
STRIPE_WEBHOOK_SECRET=replace-in-local-env
# Paystack settles the Nigerian corridor: a payer whose billing country is NG,
# or any NGN-denominated charge, is routed here instead of Stripe.
# Dashboard > Settings > API Keys & Webhooks. Test keys work without business
# verification; live keys need CAC number, TIN, and an NGN settlement account.
# Register the webhook URL on that same page: /v1/webhooks/paystack
PAYSTACK_SECRET_KEY=replace-in-local-env
# Leave unset in every real environment. Paystack has no separate webhook
# secret — it signs bodies with PAYSTACK_SECRET_KEY, which is the fallback.
# This override exists only so tests can sign with a fixed value.
# PAYSTACK_WEBHOOK_SECRET=
# Which identity-verification route runs: `manual` puts uploaded documents in
# front of an admin; `persona` hands off to the hosted provider flow. Defaults
# to manual, so every PERSONA_* setting below is inert unless this is changed.
# KYC_PROVIDER=manual
# Persona identity verification (KYC) — only read when KYC_PROVIDER=persona.
# Create an inquiry template in the Persona dashboard and point a webhook at
# /v1/webhooks/persona using the same secret.
PERSONA_API_KEY=replace-in-local-env
PERSONA_WEBHOOK_SECRET=replace-in-local-env
PERSONA_INQUIRY_TEMPLATE_ID=replace-in-local-env
# Selects Sandbox vs Production on the hosted-flow link (starts `env_`). Read it
# from the Persona dashboard, or off any API response's persona-environment-id
# header. No default: guessing Production would run real identity checks.
# Verification uses a hosted link rather than POST /inquiries — the Auracles
# Persona environment does not have `inquiries.create.api` enabled.
PERSONA_ENVIRONMENT_ID=replace-in-local-env
# Frontend page Persona returns the user to after the hosted flow completes.
PERSONA_REDIRECT_URL=http://localhost:3000/settings/kyc
# Google sign-in (OAuth 2.0 authorization-code flow). Create an OAuth client in
# the Google Cloud console with scopes openid/email/profile. GOOGLE_REDIRECT_URI
# must point at the frontend proxy path so the state + refresh cookies stay
# same-origin, and must be registered as an authorized redirect URI in Google.
GOOGLE_CLIENT_ID=replace-in-local-env
GOOGLE_CLIENT_SECRET=replace-in-local-env
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# Google Drive connector (read-only file import). Same OAuth client; this
# callback must also be registered as an authorized redirect URI in Google.
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/connectors/google-drive/callback
BRAVE_SEARCH_API_KEY=replace-in-local-env
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
OCR_TESSERACT_COMMAND=tesseract
OCR_TIMEOUT_SECONDS=60
OCR_PDF_DPI=200
OCR_TESSERACT_PAGE_SEGMENTATION_MODE=6
PLATFORM_COMMISSION_RATE=0.15
# The single currency the platform prices, charges, earns, and pays out in.
# Auracles is single-currency by design: there is no conversion step anywhere in
# the money path. NGN runs the closed Nigerian pilot, where both the buyer and
# the seller are Nigerian. Must be one of USD or NGN — anything else fails at
# boot rather than at charge time. Changing this on a database that has already
# traded will strand the existing balances; see app/core/currency.py.
PLATFORM_CURRENCY=NGN
# Virus scanning. The worker runs on the host locally, so point it at the
# clamav container over TCP (start it with `docker compose up -d clamav`).
# Leave CLAMAV_HOST unset to fall back to a local Unix-socket clamd instead.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Error tracking. Leave blank locally and in tests — blank counts as absent and
# the SDK is never initialised. Set it per deployed environment to turn
# reporting on: create a project in Sentry and copy its DSN, which looks like
# https://<public_key>@o000000.ingest.sentry.io/0000000. The embedded key is
# public and write-only (it can send events, not read them), so a leak costs
# you event quota rather than data — but don't publish it.
# The SDK is configured to send neither request bodies nor stack-frame local
# variables; app/core/observability.py explains why both would otherwise carry
# passwords, Nigerian bank details, and decrypted TOTP seeds. Do not relax that.
SENTRY_DSN=
# Performance tracing, off by default. Sentry bills by event volume, so
# sampling requests spends the quota that error reporting needs. Raise only
# when investigating something specific.
SENTRY_TRACES_SAMPLE_RATE=0.0
# Database connection pool bounds, applied per process. api, worker, and Beat
# each run their own pool, so the total against the database is the sum of all
# three — managed Postgres caps connections per tier and will refuse the rest.
# Suggested production split: api 5+5, worker 3+2, beat 1+1. In production also
# point DATABASE_URL at the provider's *pooled* endpoint: the driver pool and
# the provider's pooler are separate layers and both need sizing.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Realtime WebSocket resource caps, enforced per API process. Each inbound
# message re-validates the session against the database, so these are what stop
# one account's reconnect loop or message flood from draining the connection
# pool and taking the HTTP API down with it. Raise deliberately, not reflexively.
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_MESSAGES_PER_SECOND=10
WS_MAX_SUBSCRIPTIONS_PER_SOCKET=50