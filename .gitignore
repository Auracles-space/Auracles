.DS_Store

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
backend/.venv/
backend/.env
backend/.env.prod
.pnpm-store/

# Node
node_modules/
frontend/.next/
frontend/out/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
frontend/.env.local
frontend/tsconfig.tsbuildinfo

# Local tooling
.env
.env.prod
# Celery Beat's local run-state database. Machine-specific and regenerated on
# start; committing it would hand another machine this one's last-run times.
celerybeat-schedule
celerybeat-schedule.db
celerybeat.pid

# Terraform
# Provider binaries and lock-adjacent working state — machine-specific, large.
**/.terraform/*
# State must never be committed: it holds resource ids and, for some providers,
# secret values in clear text. It lives in S3, which is the whole point.
*.tfstate
*.tfstate.*
*.tfstate.backup
# Saved plans. Binary, short-lived, and can embed variable values.
tfplan
*.tfplan
# Per-account backend settings (bucket name embeds an AWS account id).
# backend.hcl.example is committed in its place.
backend.hcl
# Note: *.tfvars is deliberately NOT ignored. Environment tfvars are committed
# by design — secrets are referenced by Secrets Manager ARN, never inlined, so
# there is nothing sensitive in them and losing them would lose the config.
crash.log
crash.*.log
